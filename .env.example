# =====================================================================
# FormaturasFlow — variaveis de ambiente
#
# Copie este arquivo para .env.local (dev) ou configure no painel Vercel
# (Settings -> Environment Variables) para producao/preview.
# =====================================================================

# --- Supabase (auth + banco atual, ainda em uso durante a migracao) ---
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# ATENCAO: SERVICE_ROLE_KEY e server-only. Nunca prefixe com VITE_
# nem exponha no client bundle. Configure no Vercel como "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=<so-server-side>

# --- FormaturasFlow API (nossa API .NET na VPS) ---
# URL publica HTTPS via nip.io (temporario, ate ter dominio proprio)
VITE_API_URL=https://api-191-101-78-252.nip.io
FORMATURAS_API_URL=https://api-191-101-78-252.nip.io

# Token JWT de servico (super_admin) usado pelas server functions
# do TanStack Start para chamadas server-to-server.
# Nao prefixe com VITE_ — server only. No Vercel: Sensitive.
FORMATURAS_API_TOKEN=<gerar-fazendo-login-e-copiando-accessToken>
